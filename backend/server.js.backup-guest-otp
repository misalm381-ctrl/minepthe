            FROM books
            WHERE id = ?
            `,
            [req.params.id]
        );

        if (
            rows.length > 0 &&
            rows[0].donor_id
        ) {

            await db.execute(
                `
                INSERT INTO donor_reputation
                (
                    user_id,
                    verified_books,
                    points
                )
                VALUES (?, 1, 10)
                ON DUPLICATE KEY UPDATE
                    verified_books =
                        verified_books + 1,
                    points =
                        points + 10
                `,
                [rows[0].donor_id]
            );
        }

        res.json({
            success: true,
            message: "Book verified successfully."
        });

    } catch (error) {

        console.error(error);

        res.status(500).json({
            success: false,
            message:
                "Unable to verify book."
        });
    }

