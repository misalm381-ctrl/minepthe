        ) {

            return res.status(403).json({
                success: false,
                message:
                    "Please verify your phone number before donating."
            });
        }

        const guestDonorId =
            guestRows[0].id;

        const [result] = await db.execute(
            `
            INSERT INTO books
            (
                title,
                author,
                subject,
                description,
                cover_image,
                status,
                guest_donor_id
            )
            VALUES (?, ?, ?, ?, ?, 'pending', ?)
            `,
            [
                title,
                author || null,
                subject || null,
                description || null,
                coverImage,
                guestDonorId
            ]
        );

        res.status(201).json({
            success: true,
            message:
                "Guest book donation submitted successfully.",
