        if (status === "accepted") {

            await db.execute(
                `
                UPDATE books
                SET status = 'requested'
                WHERE id = ?
                `,
                [request.book_id]
            );

        }

        if (status === "collected") {

            await db.execute(
                `
                UPDATE books
                SET status = 'transferred'
                WHERE id = ?
                `,
                [request.book_id]
            );

        }

        res.json({
            success: true,
            message:
                "Request status updated successfully.",
            request
        });

    } catch (error) {

        console.error("Update request status error:");
        console.error(error);

        res.status(400).json({
            success: false,
            message: error.message
