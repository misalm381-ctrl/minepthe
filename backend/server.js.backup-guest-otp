   GUEST OTP
========================================================= */

const otpStore = new Map();


app.post("/api/guest/send-otp", async (req, res) => {

    const phone = String(req.body.phone || "").trim();

    if (!/^[0-9]{10}$/.test(phone)) {

        return res.status(400).json({
            success: false,
            message:
                "Please enter a valid 10-digit phone number."
        });
    }

    const demoOtp = Math.floor(
        100000 + Math.random() * 900000
    ).toString();

    otpStore.set(phone, {
        otp: demoOtp,
        expiresAt: Date.now() + 5 * 60 * 1000
    });

    console.log(
        "MINEPTHE demo OTP for " +
        phone +
        ": " +
        demoOtp
    );

    res.json({
        success: true,
        message: "Demo OTP generated successfully.",
        demoOtp
    });

});


app.post("/api/guest/verify-otp", async (req, res) => {

    try {

        if (!requireDatabase(res)) {
            return;
        }

        const phone = String(req.body.phone || "").trim();
        const otp = String(req.body.otp || "").trim();

        const savedOtp = otpStore.get(phone);

        if (!savedOtp) {

            return res.status(400).json({
                success: false,
                message:
                    "No OTP found. Please generate a new OTP."
            });
        }

        if (Date.now() > savedOtp.expiresAt) {

            otpStore.delete(phone);

            return res.status(400).json({
                success: false,
                message:
                    "OTP expired. Please generate a new OTP."
            });
        }

        if (savedOtp.otp !== otp) {

            return res.status(400).json({
                success: false,
                message: "Invalid OTP."
            });
        }

        otpStore.delete(phone);

        const [existing] = await db.execute(
            `
            SELECT id
            FROM guest_donors
            WHERE phone = ?
            LIMIT 1
            `,
            [phone]
        );

        let guestDonorId;

        if (existing.length > 0) {

            guestDonorId = existing[0].id;

            await db.execute(
                `
                UPDATE guest_donors
                SET
                    phone_verified = 1,
                    verified_at = CURRENT_TIMESTAMP
                WHERE id = ?
                `,
                [guestDonorId]
            );

        } else {

            const [result] = await db.execute(
                `
                INSERT INTO guest_donors
                (
                    email,
                    phone,
                    phone_verified,
                    verified_at
                )
                VALUES (?, ?, 1, CURRENT_TIMESTAMP)
                `,
                [
                    "guest_" +
                    phone +
                    "_" +
                    Date.now() +
                    "@minepthe.local",
                    phone
                ]
            );

            guestDonorId = result.insertId;
        }

        res.json({
            success: true,
            message: "Phone number verified successfully.",
            guestDonorId
        });

    } catch (error) {

        console.error("OTP verification error:");
        console.error(error);

        res.status(500).json({
            success: false,
            message: "OTP verification failed."
        });
    }

});


