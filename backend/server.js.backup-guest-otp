            String(req.body.author || "").trim();

        const subject =
            String(req.body.subject || "").trim();

        const description =
            String(req.body.description || "").trim();

        const coverImage =
            req.body.cover_image || null;

        if (!phone || !title) {

            return res.status(400).json({
                success: false,
                message:
                    "Phone and book title are required."
            });
