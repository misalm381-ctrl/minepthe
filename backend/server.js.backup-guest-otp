            (
                request_id,
                sender_id,
                sender_type,
                message
            )
            VALUES (?, ?, ?, ?)
            `,
            [
                requestId,
                senderId || null,
                senderType,
                message
            ]
        );

        const [rows] = await db.execute(
            `
            SELECT *
            FROM messages
            WHERE id = ?
            `,
            [result.insertId]
        );

        res.status(201).json({
            success: true,
            message: rows[0]
        });

    } catch (error) {

        console.error(error);

        res.status(500).json({
